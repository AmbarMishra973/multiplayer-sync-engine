{
  "name": "realtime-multiplayer-sync-engine",
  "version": "1.0.0",
  "description": "Zero-dependency RFC-6455 WebSocket multiplayer cursor and state sync engine",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "test:server": "npm --prefix server test",
    "test": "npm run test:server",
    "start:server": "npm --prefix server start",
    "preview:client": "npm --prefix client run preview"
  },
  "keywords": ["websocket", "realtime", "cursor-sync", "interpolation", "rfc6455"],
  "license": "MIT"
}
